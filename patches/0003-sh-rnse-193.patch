diff -ruN a/arch/sh/kernel/cpu/sh4/probe.c b/arch/sh/kernel/cpu/sh4/probe.c
--- a/arch/sh/kernel/cpu/sh4/probe.c	2026-11-21 02:03:01
+++ b/arch/sh/kernel/cpu/sh4/probe.c	2026-11-21 02:13:18
@@ -118,7 +118,12 @@
 		break;
 	case 0x3004:
 	case 0x3007:
-		boot_cpu_data.type = CPU_SH7785;
+		/* PVR 0x10300700 is the SH7785's too: the Audi RNS-E 193's
+		 * R8A77730 is told by its PRR, 0x412. */
+		if (prr == 0x41)
+			boot_cpu_data.type = CPU_R8A77730;
+		else
+			boot_cpu_data.type = CPU_SH7785;
 		break;
 	case 0x4004:
 	case 0x4005:
