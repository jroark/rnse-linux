diff -ruN a/arch/sh/Kconfig b/arch/sh/Kconfig
--- a/arch/sh/Kconfig	2026-11-21 02:03:00
+++ b/arch/sh/Kconfig	2026-11-21 02:04:30
@@ -434,6 +434,15 @@
 	bool "Support SH7770 processor"
 	select CPU_SH4A
 
+config CPU_SUBTYPE_R8A77730
+	bool "Support R8A77730 processor (Audi RNS-E 193)"
+	select CPU_SH4A
+	help
+	  The system-on-chip of the Audi RNS-E 193 navigation unit, of
+	  Renesas' SH-Navi family, with no public manual: an SH-4A core,
+	  the SH7780's INTC2 at 0xff804000, a TMU at 0xffd80000, SCIF-like
+	  serial ports and an R-Car-like display unit.
+
 config CPU_SUBTYPE_SH7780
 	bool "Support SH7780 processor"
 	select CPU_SH4A
@@ -670,6 +679,7 @@
 
 config ZERO_PAGE_OFFSET
 	hex
+	default "0x00200000" if SH_RNSE193
 	default "0x00010000" if PAGE_SIZE_64KB || SH_RTS7751R2D || \
 				SH_7751_SOLUTION_ENGINE
 	default "0x00004000" if PAGE_SIZE_16KB || SH_SH03
diff -ruN a/arch/sh/boards/Kconfig b/arch/sh/boards/Kconfig
--- a/arch/sh/boards/Kconfig	2026-11-21 02:03:02
+++ b/arch/sh/boards/Kconfig	2026-11-21 02:03:18
@@ -316,6 +316,16 @@
 	  0x0c000000).  The kernel is started from an SD card by the rnse
 	  SDK's linuxboot loader.
 
+config SH_RNSE193
+	bool "Audi RNS-E 193"
+	depends on CPU_SUBTYPE_R8A77730
+	select INPUT
+	help
+	  Select RNS-E 193 if you are configuring for the 193 generation of
+	  the Audi RNS-E navigation unit (R8A77730, 128 MiB at 0x08000000,
+	  an 800x480 screen).  The kernel is started from an SD card by the
+	  rnse SDK's linuxboot, after the SD loader on a disc.
+
 config SH_SHMIN
 	bool "SHMIN"
 	depends on CPU_SUBTYPE_SH7706
